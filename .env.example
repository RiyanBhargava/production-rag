# Copy to .env only on a fresh installation. Never commit .env.
# Main setup: PostgreSQL in Docker + local Ollama and automatic model routing.
APP_ENV=production
STORAGE_BACKEND=postgres
MODEL_MODE=ollama
DATA_DIR=./data

# Generate two DIFFERENT secrets; replace every placeholder before starting.
API_KEYS={"replace-with-your-random-app-secret":"my-company"}
POSTGRES_PASSWORD=replace-with-your-random-database-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-your-random-database-password@127.0.0.1:5432/rag

# Docker supplies host.docker.internal; this address is for host Python commands.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LIGHT_MODEL=llama3.2:1b
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSIONS=768
MODEL_ROUTING_ENABLED=true
ROUTING_CONTEXT_CHARS=6000
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CONTEXT_TOKENS=8192
# CPU execution avoids the GPU runner stalls observed on this laptop.
# Remove these two settings to let Ollama choose devices on other hardware.
OLLAMA_NUM_GPU=0
OLLAMA_EMBEDDING_NUM_GPU=0
RERANKER_MODE=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Required while tracing is true. TRACE_CONTENT=true uploads prompts/evidence/answers.
LANGSMITH_TRACING=true
TRACE_CONTENT=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Optional providers: MODEL_MODE=gemini or openai; set MODEL_ROUTING_ENABLED=false.
# Gemini keeps Ollama embeddings. OpenAI needs a fresh compatible store.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning; application defaults are shown.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CANDIDATE_K=20
CONTEXT_K=5
CONTEXT_CHARS=12000
MAX_ATTEMPTS=2
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=2000000
MAX_CHUNKS=5000
