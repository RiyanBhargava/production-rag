APP_ENV=development
STORAGE_BACKEND=chroma
MODEL_MODE=demo
DATA_DIR=./data
# JSON mapping of secret API keys to tenant IDs. Replace before remote deployment.
API_KEYS={"local-change-me":"demo"}
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DATABASE_URL=
RERANKER_MODE=lexical
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-rag
TRACE_CONTENT=false

# Local models: no paid provider account required
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONTEXT_TOKENS=8192
